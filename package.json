{
    "name": "gnosis",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "start": "turbo run start",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
        "check-types": "turbo run check-types",
        "db:generate": "turbo run generate --filter=@gnosis/database",
        "db:migrate": "pnpm --filter @gnosis/database migrate",
        "db:studio": "pnpm --filter @gnosis/database studio",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.7.4",
        "turbo": "^2.9.6",
        "typescript": "5.9.2"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=18"
    },
    "lint-staged": {
        "*.{ts,tsx,md,json}": "prettier --write"
    }
}
