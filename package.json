{
    "name": "gnosis",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "start": "turbo run start",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
        "typecheck": "turbo run typecheck",
        "db:generate": "turbo run generate --filter=@gnosis/database",
        "db:migrate": "cd packages/database && bun run migrate",
        "db:studio": "bun run --filter @gnosis/database studio",
        "pre-push": "bun run format:check && bun run lint && bun run typecheck",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "turbo": "^2.10.9",
        "typescript": "6.0.3"
    },
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "lint-staged": {
        "*.{ts,tsx,md,json}": "prettier --write"
    }
}
