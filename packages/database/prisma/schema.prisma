generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id    Int     @id @default(autoincrement())
    email String  @unique
    name  String
    image String?
    provider String?
    providerId String?
    createdAt String
    updatedAt String
    
    @@index([email])
}