    },
    "devDependencies": {
        "@gnosis/eslint-config": "workspace:*",
        "@gnosis/typescript-config": "workspace:*",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.6.0",
        "esbuild": "^0.28.0",
        "eslint": "^9.39.1",
        "tsx": "^4.21.0"
    }
}
